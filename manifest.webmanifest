{
  "name": "Anime Partner",
  "short_name": "Anime Partner",
  "description": "Your personal anime companion \u2014 discover anime and movies, track every episode, learn Japanese and play games. Developed by Shin.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "fullscreen",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0b0712",
  "theme_color": "#a06bff",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "entertainment",
    "lifestyle",
    "education"
  ],
  "prefer_related_applications": false,
